{
  "name": "mac-analyzer-pro-next",
  "version": "2.1.0-beta.1",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "description": "Browser-first Smartroom network equipment analyzer",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "syntax": "node --check src/app.js && node --check src/core/enrichment.js && node --check src/data/database.js",
    "lint": "eslint src tests",
    "build": "node scripts/build-portable.mjs",
    "build:windows-backend": "node scripts/build-windows-backend.mjs",
    "package:release": "pnpm build && pnpm build:windows-backend && node scripts/check-windows-backend.mjs && node scripts/build-release-archive.mjs && node scripts/check-release-archive.mjs",
    "check:release-readiness": "node scripts/check-release-readiness.mjs",
    "update:ieee-registry": "node scripts/update-ieee-registry.mjs",
    "check": "node scripts/check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "fake-indexeddb": "6.2.5"
  },
  "dependencies": {
    "@subframe7536/sqlite-wasm": "1.4.0",
    "jspdf": "4.2.1"
  }
}
